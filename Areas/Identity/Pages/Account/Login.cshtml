@page
@model FixPal.Areas.Identity.Pages.Account.LoginModel
@{ ViewData["Title"] = "تسجيل الدخول"; }
<section class="fp-auth"><span class="fp-eyebrow">أهلًا بعودتك</span><h1>كمّل من حيث بدأت.</h1><p>سجّل الدخول لإرسال طلباتك ومتابعة العمل.</p><form method="post" asp-route-returnUrl="@Model.ReturnUrl"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><div class="mb-3"><label asp-for="Input.Email" class="form-label"></label><input asp-for="Input.Email" class="form-control" autocomplete="username" dir="ltr" /><span asp-validation-for="Input.Email" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Password" class="form-label"></label><input asp-for="Input.Password" class="form-control" autocomplete="current-password" dir="ltr" /><span asp-validation-for="Input.Password" class="text-danger"></span></div><div class="form-check mb-3"><input asp-for="Input.RememberMe" class="form-check-input" /><label asp-for="Input.RememberMe" class="form-check-label"></label></div><button class="btn fp-btn-gold w-100" type="submit">تسجيل الدخول</button></form><p class="mt-4 mb-0">ليس لديك حساب؟ <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fp-text-link">إنشاء حساب</a></p><a asp-area="" asp-controller="Providers" asp-action="Index" class="fp-text-link d-inline-block mt-3">متابعة التصفّح</a></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
