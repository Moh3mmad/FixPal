@model FixPal.Models.ViewModels.PagedResult<FixPal.Models.ViewModels.RequestSummaryViewModel>
@using FixPal.Models.Enums
@{ ViewData["Title"] = "مساحة عمل المزود"; ViewData["ListController"] = "ProviderRequests"; var selected = ViewData["StatusFilter"] as MaintenanceRequestStatus?; }
<div class="container fp-workspace"><div class="fp-page-heading"><div><span class="fp-eyebrow">مساحة عمل المزود</span><h1>طلبات تحتاج خبرتك.</h1><p>هنا تظهر الطلبات المعيّنة لك. افتح الطلب للاطّلاع على الخطوة التالية.</p></div></div>
<a asp-action="Available" class="btn fp-btn-gold mb-4">طلبات متاحة لتخصصك</a> <a class="btn fp-btn-ghost mb-4" asp-controller="ProviderPortfolio" asp-action="Index">أعمالي</a><nav class="fp-filter-tabs" aria-label="تصفية حسب الحالة"><a asp-area="" asp-action="Index" class="@(selected == null ? "active" : "")">الكل</a>@foreach (var state in new[] { MaintenanceRequestStatus.Pending, MaintenanceRequestStatus.Accepted, MaintenanceRequestStatus.InProgress, MaintenanceRequestStatus.Completed }) { <a asp-area="" asp-action="Index" asp-route-status="@state" class="@(selected == state ? "active" : "")">@FixPal.Infrastructure.RequestWorkflow.Label(state)</a> }</nav>
<partial name="_Flash" /><partial name="_RequestList" model="Model" /></div>

