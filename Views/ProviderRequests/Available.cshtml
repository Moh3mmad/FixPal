@model FixPal.Models.ViewModels.PagedResult<FixPal.Models.ViewModels.ClaimableRequestItem>
@{ ViewData["Title"] = "طلبات متاحة لتخصصك"; }
<div class="container fp-workspace">
    <a asp-action="Index" class="fp-text-link">العودة إلى طلباتي المعيّنة</a>
    <div class="fp-page-heading mt-4"><div><h1>طلبات متاحة لتخصصك ومنطقتك</h1><p>لا تظهر التفاصيل الخاصة قبل تعيينك. اختيار الطلب يسجل استعدادك لتقديم عرض، وليس اتفاقًا نهائيًا.</p></div></div>
    <partial name="_Flash" />
    @if (Model.Items.Count == 0) { <p class="fp-notice">لا توجد طلبات متاحة مطابقة حاليًا.</p> }
    @foreach (var item in Model.Items)
    {
        <article class="fp-request-row">
            <div><h2 class="h5">@item.Category</h2><p>@item.Location</p><time data-utc="@item.CreatedAtUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">@item.CreatedAtUtc.ToString("u")</time></div>
            <form asp-action="Claim" asp-route-id="@item.Id" method="post"><button class="btn fp-btn-gold" type="submit">تولي الطلب وتقديم عرض</button></form>
        </article>
    }
    <nav class="fp-pagination">
        @if (Model.Page > 1) { <a asp-action="Available" asp-route-page="@(Model.Page - 1)">السابق</a> }
        <span>صفحة @Model.Page من @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages) { <a asp-action="Available" asp-route-page="@(Model.Page + 1)">التالي</a> }
    </nav>
</div>
