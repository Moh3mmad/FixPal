@model FixPal.Models.ViewModels.PublicProviderViewModel
<section class="fp-detail-panel mt-4" aria-labelledby="portfolio-title">
    <h2 id="portfolio-title">أعمال المزود</h2>
    <p class="fp-field-hint">أعمال ينشرها المزود بنفسه لعرض خبرته.</p>
    @if (Model.Portfolio.Items.Count == 0) { <p>لم يضف مزود الخدمة أعمالًا إلى ملفه بعد.</p> }
    <div class="fp-provider-grid">
    @foreach (var item in Model.Portfolio.Items)
    {
        <article class="fp-provider-card">
            <img src="@Url.Action("Image", "ProviderPortfolio", new { id = item.Id })" alt="@item.Title" loading="lazy" style="width:100%;height:220px;object-fit:contain" />
            <h3>@item.Title</h3>
            @if (!string.IsNullOrWhiteSpace(item.Description)) { <p class="fp-description">@item.Description</p> }
            <span class="fp-field-hint">منشور بواسطة المزود</span>
        </article>
    }
    </div>
    @if (Model.Portfolio.TotalPages > 1)
    {
        <nav class="fp-pagination" aria-label="صفحات أعمال المزود">
            @if (Model.Portfolio.Page > 1) { <a asp-controller="Providers" asp-action="Details" asp-route-id="@Model.Id" asp-route-page="@Model.Reviews.Page" asp-route-portfolioPage="@(Model.Portfolio.Page - 1)">السابق</a> }
            <span>@Model.Portfolio.Page / @Model.Portfolio.TotalPages</span>
            @if (Model.Portfolio.Page < Model.Portfolio.TotalPages) { <a asp-controller="Providers" asp-action="Details" asp-route-id="@Model.Id" asp-route-page="@Model.Reviews.Page" asp-route-portfolioPage="@(Model.Portfolio.Page + 1)">التالي</a> }
        </nav>
    }
</section>
<section class="fp-detail-panel mt-3" aria-label="نشاط الخدمات عبر المنصة">
    <h2>نشاط الخدمات عبر FixPal</h2>
    <p>@Model.CompletedServiceCount خدمات مكتملة عبر FixPal</p>
    <small class="fp-field-hint">إحصاء مستقل من الطلبات المكتملة باتفاق وسعر نهائي مقبولين. صور الأعمال أعلاه ينشرها المزود بنفسه.</small>
</section>
