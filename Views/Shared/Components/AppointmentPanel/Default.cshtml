@model FixPal.Services.AppointmentPanelReadModel
@using FixPal.Models.Enums
@functions {
    private static DateTimeOffset ToDisplayTime(DateTimeOffset value, string timeZoneId)
    {
        try
        {
            return TimeZoneInfo.ConvertTime(value, TimeZoneInfo.FindSystemTimeZoneById(timeZoneId));
        }
        catch (TimeZoneNotFoundException)
        {
            return value.ToUniversalTime();
        }
        catch (InvalidTimeZoneException)
        {
            return value.ToUniversalTime();
        }
        catch (ArgumentException)
        {
            return value.ToUniversalTime();
        }
    }

    private static string StatusLabel(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Scheduled => "موعد مؤكد",
        AppointmentStatus.InProgress => "العمل قيد التنفيذ",
        AppointmentStatus.Completed => "مكتمل",
        AppointmentStatus.Cancelled => "ملغي",
        AppointmentStatus.Superseded => "تم استبداله",
        _ => status.ToString()
    };
}

<section class="fp-detail-panel mt-4" dir="rtl" aria-labelledby="appointment-heading">
    <div class="fp-section-heading">
        <div>
            <span class="fp-eyebrow">الجدولة</span>
            <h2 id="appointment-heading">موعد الزيارة</h2>
        </div>
    </div>

    @if (Model.RequestType != RequestType.PrivateService)
    {
        <p class="fp-notice">المواعيد متاحة لطلبات الصيانة الخاصة فقط.</p>
    }
    else if (Model.ActiveAppointment is { } active)
    {
        var start = ToDisplayTime(active.StartUtc, active.TimeZoneId);
        var end = ToDisplayTime(active.EndUtc, active.TimeZoneId);
        <div class="fp-notice">
            <strong>@StatusLabel(active.Status)</strong>
            <div><time datetime="@active.StartUtc.ToString("O")">@start.ToString("yyyy/MM/dd HH:mm")</time> – <time datetime="@active.EndUtc.ToString("O")">@end.ToString("yyyy/MM/dd HH:mm")</time></div>
            <div>المنطقة الزمنية: <bdi>@active.TimeZoneId</bdi></div>
        </div>

        @if (active.Status == AppointmentStatus.Scheduled && Model.RequestStatus == MaintenanceRequestStatus.Accepted)
        {
            <div class="fp-commerce-grid mt-3">
                <form asp-area="" asp-controller="Appointments" asp-action="Reschedule" method="post" class="fp-detail-panel">
                    <h3>تغيير الموعد</h3>
                    <input type="hidden" name="MaintenanceRequestId" value="@Model.MaintenanceRequestId" />
                    <input type="hidden" name="AppointmentId" value="@active.Id" />
                    <input type="hidden" name="ExpectedAppointmentRowVersion" value="@active.RowVersion" />
                    <label class="form-label" for="appointment-reschedule-start">البداية الجديدة</label>
                    <input class="form-control" id="appointment-reschedule-start" name="StartLocal" type="datetime-local" step="60" required />
                    <label class="form-label mt-2" for="appointment-reschedule-end">النهاية الجديدة</label>
                    <input class="form-control" id="appointment-reschedule-end" name="EndLocal" type="datetime-local" step="60" required />
                    <p class="fp-field-hint mt-2">تُفسّر الأوقات وفق منطقة تقويم المزود: <bdi>@active.TimeZoneId</bdi>.</p>
                    <button class="btn fp-btn-gold" type="submit">حفظ الموعد الجديد</button>
                </form>
                <form asp-area="" asp-controller="Appointments" asp-action="Cancel" method="post" class="fp-detail-panel">
                    <h3>إلغاء الموعد</h3>
                    <input type="hidden" name="MaintenanceRequestId" value="@Model.MaintenanceRequestId" />
                    <input type="hidden" name="AppointmentId" value="@active.Id" />
                    <input type="hidden" name="ExpectedAppointmentRowVersion" value="@active.RowVersion" />
                    <p>يلغي هذا الإجراء الموعد فقط مع الاحتفاظ بسجله، ولا يلغي طلب الصيانة.</p>
                    <button class="btn btn-outline-danger" type="submit">إلغاء الموعد</button>
                </form>
            </div>
        }
        else if (active.Status == AppointmentStatus.InProgress)
        {
            <p class="fp-field-hint">بدأ تنفيذ العمل، لذلك لم يعد الموعد قابلاً للتغيير أو الإلغاء.</p>
        }
    }
    else if (Model.RequestStatus != MaintenanceRequestStatus.Accepted)
    {
        <p class="fp-notice">تصبح الجدولة متاحة بعد قبول الطلب واستكمال الاتفاق المطلوب.</p>
    }
    else if (!Model.HasAcceptedAgreement)
    {
        <p class="fp-notice">لا يوجد اتفاق مقبول بعد. يجب قبول عرض محدد قبل حجز موعد.</p>
    }
    else if (Model.CalendarTimeZoneId == null)
    {
        <p class="fp-notice">لم يُعِدّ مزود الخدمة تقويم العمل بعد.</p>
    }
    else if (Model.CalendarEnabled != true)
    {
        <p class="fp-notice">أوقف مزود الخدمة استقبال مواعيد جديدة حاليًا.</p>
    }
    else
    {
        <form asp-area="" asp-controller="Appointments" asp-action="Schedule" method="post">
            <input type="hidden" name="MaintenanceRequestId" value="@Model.MaintenanceRequestId" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="appointment-start">بداية الموعد</label>
                    <input class="form-control" id="appointment-start" name="StartLocal" type="datetime-local" step="60" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="appointment-end">نهاية الموعد</label>
                    <input class="form-control" id="appointment-end" name="EndLocal" type="datetime-local" step="60" required />
                </div>
            </div>
            <p class="fp-field-hint mt-2">تُفسّر الأوقات وفق منطقة تقويم المزود: <bdi>@Model.CalendarTimeZoneId</bdi>.</p>
            <button class="btn fp-btn-gold" type="submit">حجز الموعد</button>
        </form>
    }

    @if (Model.History.Count > 0)
    {
        <details class="mt-3">
            <summary>سجل المواعيد السابقة</summary>
            <ul class="mt-2">
                @foreach (var item in Model.History)
                {
                    var historicalStart = ToDisplayTime(item.StartUtc, item.TimeZoneId);
                    var historicalEnd = ToDisplayTime(item.EndUtc, item.TimeZoneId);
                    <li>
                        <strong>@StatusLabel(item.Status)</strong> —
                        <time datetime="@item.StartUtc.ToString("O")">@historicalStart.ToString("yyyy/MM/dd HH:mm")</time>
                        إلى
                        <time datetime="@item.EndUtc.ToString("O")">@historicalEnd.ToString("yyyy/MM/dd HH:mm")</time>
                        <span>(<bdi>@item.TimeZoneId</bdi>)</span>
                    </li>
                }
            </ul>
        </details>
    }
</section>
