@model FixPal.Services.AppointmentPanelReadModel
@using FixPal.Models.Enums
@using FixPal.Models.ViewModels
@functions {
    private static string StatusLabel(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Confirmed => "موعد مؤكد",
        AppointmentStatus.InProgress => "العمل قيد التنفيذ",
        AppointmentStatus.Completed => "مكتمل",
        AppointmentStatus.Cancelled => "ملغي",
        AppointmentStatus.Superseded => "تم استبداله",
        AppointmentStatus.Proposed => "بانتظار التأكيد",
        AppointmentStatus.Rejected => "مرفوض",
        _ => status.ToString()
    };
}

<section class="fp-appointment-panel" dir="rtl" aria-labelledby="appointment-heading">
    <div class="fp-section-heading">
        <div>
            <span class="fp-eyebrow">الجدولة</span>
            <h2 id="appointment-heading">موعد الزيارة</h2>
        </div>
    </div>

    @if (Model.RequestType != RequestType.PrivateService)
    {
        <p class="fp-notice">المواعيد متاحة لطلبات الصيانة الخاصة فقط.</p>
    }
    else if (Model.RequestStatus != MaintenanceRequestStatus.Accepted || !Model.HasAcceptedAgreement)
    {
        <p class="fp-notice">تصبح الجدولة متاحة بعد قبول الاتفاق.</p>
    }
    else
    {
        var canChooseTime = Model.IsOwner && Model.CalendarPreview != null && Model.CalendarEnabled == true
            && Model.PendingProposals.Count == 0
            && (Model.ConfirmedAppointment == null || Model.ConfirmedAppointment.Status == AppointmentStatus.Confirmed);
        @if (canChooseTime)
        {
            <section class="fp-customer-calendar" aria-labelledby="customer-calendar-heading"
                     data-calendar-start="@(Model.ConfirmedAppointment == null ? "appointment-start" : "appointment-reschedule-start")"
                     data-calendar-end="@(Model.ConfirmedAppointment == null ? "appointment-end" : "appointment-reschedule-end")">
                <h3 id="customer-calendar-heading">أوقات عمل مزود الخدمة خلال الأسبوع</h3>
                <p class="fp-field-hint">الأوقات حسب <bdi>@SchedulingDisplay.ZoneLabel(Model.CalendarTimeZoneId)</bdi>. «مشغول» يعني أن الوقت غير متاح فقط؛ تفاصيل الطلبات الأخرى لا تُعرض. اختر وقتًا متاحًا لملء النموذج، ثم راجعه قبل إرسال الاقتراح.</p>
                <div class="fp-customer-calendar-days">
                    @foreach (var day in Model.CalendarPreview!.Days)
                    {
                        <div class="fp-customer-calendar-day">
                            <h4>@day.Date.ToDateTime(TimeOnly.MinValue).ToString("dddd d MMM", new System.Globalization.CultureInfo("ar-PS"))</h4>
                            @if (day.Slots.Count == 0)
                            {
                                <p class="fp-field-hint mb-0">لا توجد أوقات عمل متاحة</p>
                            }
                            else
                            {
                                <div class="fp-customer-calendar-slots">
                                    @foreach (var slot in day.Slots)
                                    {
                                        <button class="fp-customer-calendar-slot @(slot.IsAvailable ? "" : "is-busy")" type="button"
                                                disabled="@(!slot.IsAvailable)"
                                                data-calendar-slot
                                                aria-pressed="false"
                                                data-start="@slot.StartLocal.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-end="@slot.EndLocal.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture)"
                                                aria-label="@slot.StartLocal.ToString("HH:mm") إلى @slot.EndLocal.ToString("HH:mm")، @(slot.IsAvailable ? "متاح" : "مشغول")">
                                            <span dir="ltr">@slot.StartLocal.ToString("HH:mm")–@slot.EndLocal.ToString("HH:mm")</span>
                                            <small>@(slot.IsAvailable ? "متاح" : "مشغول")</small>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
                <p class="fp-field-hint mb-0 mt-2">الأوقات المعروضة إرشادية وقد تتغير. يتحقق النظام من التوفر مجددًا عند تأكيد الطرف الآخر للموعد.</p>
            </section>
        }
        @if (Model.ConfirmedAppointment is { } confirmed)
        {
            <div class="fp-appointment-current">
                <span class="fp-status @confirmed.Status.ToString().ToLowerInvariant()">@StatusLabel(confirmed.Status)</span>
                <dl class="fp-appointment-times">
                    <div><dt>بداية الزيارة</dt><dd><time dir="ltr" datetime="@confirmed.StartUtc.ToString("O")">@SchedulingDisplay.Format(confirmed.StartUtc, confirmed.TimeZoneId)</time></dd></div>
                    <div><dt>نهاية الموعد المخططة</dt><dd><time dir="ltr" datetime="@confirmed.EndUtc.ToString("O")">@SchedulingDisplay.Format(confirmed.EndUtc, confirmed.TimeZoneId)</time></dd></div>
                </dl>
                <p class="fp-field-hint">الأوقات حسب <bdi>@SchedulingDisplay.ZoneLabel(confirmed.TimeZoneId)</bdi>.</p>
            </div>

            @if (confirmed.Status == AppointmentStatus.Confirmed)
            {
                var hasReplacementProposal = Model.PendingProposals.Any(p => p.ReplacesAppointmentId == confirmed.Id);
                <details class="fp-appointment-actions">
                    <summary>تغيير الموعد أو إلغاؤه</summary>
                    <div class="fp-commerce-grid">
                        @if (!hasReplacementProposal)
                        {
                            <form asp-area="" asp-controller="Appointments" asp-action="Reschedule" method="post" class="fp-appointment-edit">
                                <h3>اقتراح موعد بديل</h3>
                                <input type="hidden" name="MaintenanceRequestId" value="@Model.MaintenanceRequestId" />
                                <input type="hidden" name="AppointmentId" value="@confirmed.Id" />
                                <input type="hidden" name="ExpectedAppointmentRowVersion" value="@confirmed.RowVersion" />
                                <label class="form-label" for="appointment-reschedule-start">البداية الجديدة</label>
                                <input class="form-control" id="appointment-reschedule-start" name="StartLocal" type="datetime-local" step="60" required />
                                <label class="form-label mt-2" for="appointment-reschedule-end">النهاية الجديدة</label>
                                <input class="form-control" id="appointment-reschedule-end" name="EndLocal" type="datetime-local" step="60" required />
                                <p class="fp-field-hint mt-2">يبقى الموعد الحالي مؤكدًا حتى يقبل الطرف الآخر هذا الاقتراح. أدخل الوقت حسب <bdi>@SchedulingDisplay.ZoneLabel(Model.CalendarTimeZoneId)</bdi>.</p>
                                <button class="btn fp-btn-gold" type="submit">إرسال الاقتراح</button>
                            </form>
                        }
                        <form asp-area="" asp-controller="Appointments" asp-action="Cancel" method="post" class="fp-appointment-edit">
                            <h3 class="text-danger">إلغاء الموعد المؤكد</h3>
                            <input type="hidden" name="MaintenanceRequestId" value="@Model.MaintenanceRequestId" />
                            <input type="hidden" name="AppointmentId" value="@confirmed.Id" />
                            <input type="hidden" name="ExpectedAppointmentRowVersion" value="@confirmed.RowVersion" />
                            <p>يلغي الموعد فقط مع الاحتفاظ بسجله، ولا يلغي طلب الصيانة.</p>
                            <button class="btn btn-outline-danger" type="submit">إلغاء الموعد</button>
                        </form>
                    </div>
                </details>
            }
            else
            {
                <p class="fp-field-hint">بدأ تنفيذ العمل، لذلك لم يعد الموعد قابلاً للتغيير أو الإلغاء.</p>
            }
        }

        @if (Model.PendingProposals.Count > 0)
        {
            <div class="fp-appointment-proposals" aria-labelledby="appointment-proposals-heading">
                <h3 id="appointment-proposals-heading">اقتراحات بانتظار القرار</h3>
                @foreach (var proposal in Model.PendingProposals)
                {
                    <article class="fp-appointment-edit">
                        <span class="fp-status proposed">@(proposal.ReplacesAppointmentId == null ? "اقتراح موعد" : "اقتراح موعد بديل")</span>
                        <p class="mb-1"><strong><time dir="ltr" datetime="@proposal.StartUtc.ToString("O")">@SchedulingDisplay.Format(proposal.StartUtc, proposal.TimeZoneId)</time></strong></p>
                        <p class="fp-field-hint">حتى <time dir="ltr" datetime="@proposal.EndUtc.ToString("O")">@SchedulingDisplay.Format(proposal.EndUtc, proposal.TimeZoneId)</time> حسب <bdi>@SchedulingDisplay.ZoneLabel(proposal.TimeZoneId)</bdi>.</p>
                        @if (proposal.CreatedByCurrentUser)
                        {
                            <p>بانتظار تأكيد الطرف الآخر.</p>
                            @if (proposal.CanWithdraw)
                            {
                                <form asp-area="" asp-controller="Appointments" asp-action="Cancel" method="post">
                                    <input type="hidden" name="MaintenanceRequestId" value="@Model.MaintenanceRequestId" />
                                    <input type="hidden" name="AppointmentId" value="@proposal.Id" />
                                    <input type="hidden" name="ExpectedAppointmentRowVersion" value="@proposal.RowVersion" />
                                    <button class="btn btn-outline-danger" type="submit">سحب الاقتراح</button>
                                </form>
                            }
                        }
                        else
                        {
                            <p>اقترح الطرف الآخر هذا الموعد. راجع الوقت ثم اختر قبول الاقتراح أو رفضه.</p>
                            <div class="d-flex flex-wrap gap-2">
                                @if (proposal.CanConfirm)
                                {
                                    <form asp-area="" asp-controller="Appointments" asp-action="Confirm" method="post">
                                        <input type="hidden" name="MaintenanceRequestId" value="@Model.MaintenanceRequestId" />
                                        <input type="hidden" name="AppointmentId" value="@proposal.Id" />
                                        <input type="hidden" name="ExpectedAppointmentRowVersion" value="@proposal.RowVersion" />
                                        <button class="btn fp-btn-gold" type="submit">تأكيد الموعد</button>
                                    </form>
                                }
                                @if (proposal.CanReject)
                                {
                                    <form asp-area="" asp-controller="Appointments" asp-action="Reject" method="post">
                                        <input type="hidden" name="MaintenanceRequestId" value="@Model.MaintenanceRequestId" />
                                        <input type="hidden" name="AppointmentId" value="@proposal.Id" />
                                        <input type="hidden" name="ExpectedAppointmentRowVersion" value="@proposal.RowVersion" />
                                        <button class="btn btn-outline-danger" type="submit">رفض الاقتراح</button>
                                    </form>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }

        @if (Model.ConfirmedAppointment == null && Model.PendingProposals.Count == 0)
        {
            @if (Model.CalendarTimeZoneId == null)
            {
                <p class="fp-notice">لم يُعِدّ مزود الخدمة تقويم العمل بعد.</p>
            }
            else if (Model.CalendarEnabled != true)
            {
                <p class="fp-notice">أوقف مزود الخدمة استقبال اقتراحات مواعيد جديدة حاليًا.</p>
            }
            else
            {
                <form asp-area="" asp-controller="Appointments" asp-action="Schedule" method="post">
                    <input type="hidden" name="MaintenanceRequestId" value="@Model.MaintenanceRequestId" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="appointment-start">بداية الموعد المقترح</label>
                            <input class="form-control" id="appointment-start" name="StartLocal" type="datetime-local" step="60" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="appointment-end">نهاية الموعد المقترح</label>
                            <input class="form-control" id="appointment-end" name="EndLocal" type="datetime-local" step="60" required />
                        </div>
                    </div>
                    <p class="fp-field-hint mt-2">لن يصبح الموعد مؤكدًا إلا بعد موافقة الطرف الآخر. أدخل الوقت حسب <bdi>@SchedulingDisplay.ZoneLabel(Model.CalendarTimeZoneId)</bdi>.</p>
                    <button class="btn fp-btn-gold" type="submit">إرسال اقتراح الموعد</button>
                </form>
            }
        }
    }

    @if (Model.History.Count > 0)
    {
        <details class="mt-3">
            <summary>سجل المواعيد السابقة</summary>
            <ul class="fp-appointment-history">
                @foreach (var item in Model.History)
                {
                    <li>
                        <span class="fp-status @item.Status.ToString().ToLowerInvariant()">@StatusLabel(item.Status)</span> —
                        <time datetime="@item.StartUtc.ToString("O")">@SchedulingDisplay.Format(item.StartUtc, item.TimeZoneId)</time>
                        إلى <time datetime="@item.EndUtc.ToString("O")">@SchedulingDisplay.Format(item.EndUtc, item.TimeZoneId)</time>
                    </li>
                }
            </ul>
        </details>
    }
</section>
<script src="~/js/appointment-calendar-preview.js" asp-append-version="true" defer></script>
