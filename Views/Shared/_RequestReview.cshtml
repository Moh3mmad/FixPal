@model FixPal.Models.ViewModels.RequestDetailsViewModel
@if (Model.Review is {} review)
{ <section class="fp-detail-panel mt-4"><h2>تقييم الخدمة</h2><p>@review.Rating / 5</p><p class="fp-description">@review.Comment</p></section> }
else if (Model.CanReview)
{ <section class="fp-detail-panel mt-4"><h2>كيف كانت تجربتك؟</h2><p>يظهر التقييم والتعليق علنًا في ملف المزود دون اسمك أو رقم الطلب. لا تكتب معلومات شخصية.</p><form asp-area="" asp-controller="ProviderReviews" asp-action="Create" asp-route-id="@Model.Id" method="post"><label for="rating" class="form-label">التقييم</label><select id="rating" name="rating" class="form-select"><option value="5">5 — ممتاز</option><option value="4">4 — جيد جدًا</option><option value="3">3 — جيد</option><option value="2">2 — يحتاج تحسينًا</option><option value="1">1 — غير مرضٍ</option></select><label for="review-comment" class="form-label mt-3">تعليق اختياري</label><textarea id="review-comment" name="comment" maxlength="1000" rows="3" class="form-control"></textarea><button class="btn fp-btn-gold mt-3">نشر التقييم</button></form></section> }

