@model FixPal.Models.ViewModels.ProviderCalendarPageViewModel
@using FixPal.Services
@using FixPal.Models.ViewModels
@{
    ViewData["Title"] = "تقويم العمل";
    var dayLabels = new[] { "الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت" };
}
<div class="container fp-workspace fp-calendar-page" dir="rtl">
    <div class="fp-page-heading">
        <div>
            <span class="fp-eyebrow">إدارة المواعيد</span>
            <h1>تقويم العمل</h1>
            <p>نظّم أسبوعك وحدّد الأوقات التي تناسبك لاستقبال مواعيد الصيانة.</p>
        </div>
    </div>
    <partial name="_Flash" />

    @if (Model.Calendar == null)
    {
        <section class="fp-detail-panel">
            <h2>إنشاء تقويم العمل</h2>
            <form asp-area="" asp-controller="ProviderCalendar" asp-action="Create" method="post" data-calendar-form>
                <label class="form-label" for="create-time-zone">المنطقة الزمنية للعمل</label>
                <input class="form-control" id="create-time-zone" name="TimeZoneId" value="Asia/Hebron" maxlength="100" required dir="ltr" list="calendar-zones" /><p class="fp-field-hint">لفلسطين استخدم <bdi>Asia/Hebron</bdi>. للعمل في منطقة أخرى، أدخل معرّف توقيتها.</p>
                <div class="form-check mt-3">
                    <input class="form-check-input" id="create-enabled" name="IsEnabled" type="checkbox" value="true" checked />
                    <input name="IsEnabled" type="hidden" value="false" />
                    <label class="form-check-label" for="create-enabled">السماح بحجوزات جديدة</label>
                </div>
                <h3 class="mt-4">ساعات العمل الأسبوعية</h3><p class="fp-field-hint">أضف أيام العمل وساعاتها. يمكنك إضافة أكثر من فترة لليوم نفسه، مثل فترة صباحية وأخرى مسائية.</p>
                <div data-period-list>
                    <div class="row g-2 align-items-end fp-working-period" data-period-row>
                        <div class="col-md-4"><label class="form-label">اليوم</label><select class="form-select" name="WorkingPeriods[0].DayOfWeek" data-field="DayOfWeek" aria-label="يوم العمل"><option value="0">الأحد</option><option value="1" selected>الاثنين</option><option value="2">الثلاثاء</option><option value="3">الأربعاء</option><option value="4">الخميس</option><option value="5">الجمعة</option><option value="6">السبت</option></select></div>
                        <div class="col-md-3"><label class="form-label">من</label><input class="form-control" name="WorkingPeriods[0].StartLocal" data-field="StartLocal" aria-label="بداية فترة العمل" type="time" step="60" value="09:00" required /></div>
                        <div class="col-md-3"><label class="form-label">إلى</label><input class="form-control" name="WorkingPeriods[0].EndLocal" data-field="EndLocal" aria-label="نهاية فترة العمل" type="time" step="60" value="17:00" required /></div>
                        <div class="col-md-2"><button class="btn btn-outline-danger" type="button" data-remove-period>إزالة</button></div>
                    </div>
                </div>
                <button class="btn btn-outline-secondary" type="button" data-add-period>إضافة فترة</button>
                <button class="btn fp-btn-gold" type="submit">إنشاء التقويم</button>
            </form>
        </section>
    }
    else
    {
        <section class="fp-detail-panel">
            <h2>أسبوع العمل</h2>
            <p class="fp-calendar-state"><span class="fp-status @(Model.Calendar.IsEnabled ? "accepted" : "cancelled")">@(Model.Calendar.IsEnabled ? "يستقبل مواعيد جديدة" : "الحجوزات الجديدة متوقفة")</span><span>الأوقات حسب <bdi>@SchedulingDisplay.ZoneLabel(Model.Calendar.TimeZoneId)</bdi></span></p><p class="fp-field-hint">إيقاف الحجوزات الجديدة لا يلغي المواعيد الموجودة.</p>
            <form asp-area="" asp-controller="ProviderCalendar" asp-action="Update" method="post" data-calendar-form>
                <input type="hidden" name="ExpectedRowVersion" value="@Model.Calendar.RowVersion" />
                <label class="form-label" for="update-time-zone">معرّف المنطقة الزمنية</label>
                <input class="form-control" id="update-time-zone" name="TimeZoneId" value="@Model.Calendar.TimeZoneId" maxlength="100" required dir="ltr" />
                <div class="form-check mt-3">
                    <input class="form-check-input" id="update-enabled" name="IsEnabled" type="checkbox" value="true" checked="@Model.Calendar.IsEnabled" />
                    <input name="IsEnabled" type="hidden" value="false" />
                    <label class="form-check-label" for="update-enabled">السماح بحجوزات جديدة</label>
                </div>
                <h3 class="mt-4">ساعات العمل الأسبوعية</h3>
                <div data-period-list>
                    @for (var i = 0; i < Model.Calendar.WorkingPeriods.Count; i++)
                    {
                        var period = Model.Calendar.WorkingPeriods[i];
                        <div class="row g-2 align-items-end fp-working-period" data-period-row>
                            <div class="col-md-4">
                                <label class="form-label">اليوم</label>
                                <select class="form-select" name="WorkingPeriods[@i].DayOfWeek" data-field="DayOfWeek" aria-label="يوم العمل">
                                    @for (var day = 0; day < dayLabels.Length; day++)
                                    {
                                        <option value="@day" selected="@((int)period.DayOfWeek == day)">@dayLabels[day]</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3"><label class="form-label">من</label><input class="form-control" name="WorkingPeriods[@i].StartLocal" data-field="StartLocal" aria-label="بداية فترة العمل" type="time" step="60" value="@period.StartLocal.ToString("HH:mm")" required /></div>
                            <div class="col-md-3"><label class="form-label">إلى</label><input class="form-control" name="WorkingPeriods[@i].EndLocal" data-field="EndLocal" aria-label="نهاية فترة العمل" type="time" step="60" value="@period.EndLocal.ToString("HH:mm")" required /></div>
                            <div class="col-md-2"><button class="btn btn-outline-danger" type="button" data-remove-period>إزالة</button></div>
                        </div>
                    }
                </div>
                <button class="btn btn-outline-secondary" type="button" data-add-period>إضافة فترة</button>
                <button class="btn fp-btn-gold" type="submit">حفظ إعدادات التقويم</button>
            </form>
        </section>

        <section class="fp-detail-panel mt-4">
            <h2>فترات عدم التوفر</h2><p class="fp-field-hint">إجازة أو التزام آخر؟ احجب الفترة من الحجوزات الجديدة. لا يمكن حجب وقت يتعارض مع عمل محجوز.</p>
            @if (Model.BlackoutManagement == null)
            {
                <p class="fp-notice">تعذر تحميل سجل فترات عدم التوفر.</p>
            }
            else
            {
                <form asp-area="" asp-controller="ProviderCalendar" asp-action="CreateBlackout" method="post">
                    <input type="hidden" name="ExpectedCalendarRowVersion" value="@Model.BlackoutManagement.CalendarRowVersion" />
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label" for="blackout-start">البداية</label><input class="form-control" id="blackout-start" name="StartLocal" type="datetime-local" step="60" required /></div>
                        <div class="col-md-6"><label class="form-label" for="blackout-end">النهاية</label><input class="form-control" id="blackout-end" name="EndLocal" type="datetime-local" step="60" required /></div>
                    </div>
                    <p class="fp-field-hint mt-2">اختر الأوقات حسب <bdi>@SchedulingDisplay.ZoneLabel(Model.Calendar.TimeZoneId)</bdi>، وليس توقيت جهازك.</p>
                    <button class="btn fp-btn-gold" type="submit">إضافة فترة عدم توفر</button>
                </form>

                @if (Model.BlackoutManagement.Blackouts.Count > 0)
                {
                    <ul class="fp-blackout-list">
                        @foreach (var blackout in Model.BlackoutManagement.Blackouts)
                        {

                            <li class="mb-3">
                                <span class="fp-status @(blackout.IsRemoved ? "superseded" : "pending")">@(blackout.IsRemoved ? "أُزيل الحظر" : "غير متاح")</span> —
                                <time datetime="@blackout.StartUtc.ToString("O")">@SchedulingDisplay.Format(blackout.StartUtc, Model.Calendar.TimeZoneId)</time>
                                إلى
                                <time datetime="@blackout.EndUtc.ToString("O")">@SchedulingDisplay.Format(blackout.EndUtc, Model.Calendar.TimeZoneId)</time>
                                @if (!blackout.IsRemoved)
                                {
                                    <form asp-area="" asp-controller="ProviderCalendar" asp-action="RemoveBlackout" method="post" class="d-inline">
                                        <input type="hidden" name="BlackoutId" value="@blackout.Id" />
                                        <input type="hidden" name="ExpectedCalendarRowVersion" value="@Model.BlackoutManagement.CalendarRowVersion" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">إزالة</button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
            }
        </section>
    }
</div>

<datalist id="calendar-zones"><option value="Asia/Hebron">توقيت فلسطين</option><option value="Asia/Amman">توقيت الأردن</option><option value="Asia/Beirut">توقيت لبنان</option></datalist>
<template id="working-period-template">
    <div class="row g-2 align-items-end fp-working-period" data-period-row>
        <div class="col-md-4"><label class="form-label">اليوم</label><select class="form-select" data-field="DayOfWeek" aria-label="يوم العمل"><option value="0">الأحد</option><option value="1">الاثنين</option><option value="2">الثلاثاء</option><option value="3">الأربعاء</option><option value="4">الخميس</option><option value="5">الجمعة</option><option value="6">السبت</option></select></div>
        <div class="col-md-3"><label class="form-label">من</label><input class="form-control" data-field="StartLocal" aria-label="بداية فترة العمل" type="time" step="60" value="09:00" required /></div>
        <div class="col-md-3"><label class="form-label">إلى</label><input class="form-control" data-field="EndLocal" aria-label="نهاية فترة العمل" type="time" step="60" value="17:00" required /></div>
        <div class="col-md-2"><button class="btn btn-outline-danger" type="button" data-remove-period>إزالة</button></div>
    </div>
</template>

@section Scripts {
    <script>
        (() => {
            const template = document.getElementById('working-period-template');
            const reindex = form => {
                form.querySelectorAll('[data-period-row]').forEach((row, index) => {
                    row.querySelectorAll('[data-field]').forEach(input => {
                        input.name = `WorkingPeriods[${index}].${input.dataset.field}`;
                    });
                });
            };

            document.querySelectorAll('[data-calendar-form]').forEach(form => {
                reindex(form);
                form.querySelector('[data-add-period]').addEventListener('click', () => {
                    form.querySelector('[data-period-list]').appendChild(template.content.cloneNode(true));
                    reindex(form);
                });
                form.addEventListener('click', event => {
                    const remove = event.target.closest('[data-remove-period]');
                    if (!remove) return;
                    remove.closest('[data-period-row]').remove();
                    reindex(form);
                });
                form.addEventListener('submit', () => reindex(form));
            });
        })();
    </script>
}
