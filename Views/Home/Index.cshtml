@{ ViewData["Title"] = "الصيانة، بدون لف ودوران"; }
@section Styles { <link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" /> }
<section class="fp-home-intro">
    <div class="container fp-home-grid">
        <div class="fp-home-copy">
            <span class="fp-eyebrow">تصليحة · صيانة قريبة منك</span>
            <h1>الصيانة،<br />بدون لف ودوران.</h1>
            <p>اختار مزود، اتفق على التفاصيل، احجز موعدك، وتابع الشغل من مكان واحد.</p>
            <div class="fp-home-actions">
                <a class="btn fp-btn-gold" asp-controller="Providers" asp-action="Index">ابحث عن مزود خدمة <i class="bi bi-arrow-left" aria-hidden="true"></i></a>
                <a class="fp-text-link" asp-controller="MaintenanceRequests" asp-action="Create">لديّ مشكلة، أريد إنشاء طلب</a>
            </div>
            <p class="fp-field-hint">تصفّح بدون حساب. سجّل الدخول عندما تكون جاهزًا للطلب.</p>
        </div>
        <aside class="fp-home-ledger" aria-labelledby="home-ledger-title">
            <span class="fp-eyebrow">من أول وصف لآخر تفصيل</span>
            <h2 id="home-ledger-title">طلبك له مكان.<br />وتفاصيله محفوظة.</h2>
            <dl>
                <div><dt>الاتفاق</dt><dd>عرض سعر واضح، وقبول مسجّل</dd></div>
                <div><dt>الموعد</dt><dd>زيارة ضمن تقويم عمل المزود</dd></div>
                <div><dt>المتابعة</dt><dd>محادثة خاصة، صور، وحالة التنفيذ</dd></div>
            </dl>
            <a class="fp-text-link" href="#how-it-works">تعرّف على رحلة الطلب</a>
        </aside>
    </div>
</section>
<section id="how-it-works" class="fp-home-how">
    <div class="container fp-journey-layout">
        <div class="fp-home-section-heading">
            <span class="fp-eyebrow">كيف يعمل تصليحة؟</span>
            <h2>من «شو المشكلة؟»<br />إلى «يعطيك العافية».</h2>
            <p>خطوات واضحة بينك وبين مزود الخدمة. ارجع للتفاصيل متى احتجتها.</p>
        </div>
        <ol class="fp-home-journey">
            <li><span aria-hidden="true">01</span><div><h3>اختر مزود الخدمة</h3><p>تصفّح التخصص والمنطقة والتقييمات، أو ابدأ بطلب دون تعيين مزود.</p></div></li>
            <li><span aria-hidden="true">02</span><div><h3>اشرح المشكلة</h3><p>اكتب التفاصيل وحدد المكان، واستعن باقتراح التخصص إذا احتجت.</p></div></li>
            <li><span aria-hidden="true">03</span><div><h3>اتفق على السعر</h3><p>راجع عرض المزود. اقبله أو اطلب تعديله قبل بدء التنفيذ.</p></div></li>
            <li><span aria-hidden="true">04</span><div><h3>احجز الموعد</h3><p>بعد الاتفاق، احجز ضمن ساعات عمل المزود عندما يكون تقويمه مفعّلًا.</p></div></li>
            <li><span aria-hidden="true">05</span><div><h3>تابع التنفيذ</h3><p>تواصل في محادثة الطلب، وراجع الصور وتحديثات سير العمل.</p></div></li>
            <li><span aria-hidden="true">06</span><div><h3>قيّم التجربة</h3><p>بعد اكتمال الخدمة، شارك تجربتك لتساعد الآخرين في الاختيار.</p></div></li>
        </ol>
    </div>
</section>
<section class="fp-home-services">
    <div class="container fp-home-paths">
        <article><span class="fp-eyebrow">للبيت ومكان العمل</span><h2>كل مشكلة تبدأ بوصف.</h2><p>ابحث عن التخصص المناسب لاحتياجك. الطلب يجمعك بالمزود المعيّن، وتبقى تفاصيله خاصة بينكما ومع الإدارة.</p><a class="fp-text-link" asp-controller="Services" asp-action="Index">استكشف الخدمات</a></article>
        <article><span class="fp-eyebrow">للمكان العام</span><h2>لاحظت مشكلة في محيطك؟</h2><p>سجّل بلاغًا مجتمعيًا داخل تصليحة. يراه صاحب البلاغ والإدارة، ولا يُرسل إلى الجهات الرسمية. في الطوارئ، تواصل مع القناة الرسمية مباشرة.</p><a class="fp-text-link" asp-controller="MaintenanceRequests" asp-action="Create" asp-route-requestType="PublicReport">تسجيل بلاغ</a></article>
    </div>
</section>
<section class="fp-home-join">
    <div class="container"><div><span class="fp-eyebrow">لأصحاب الخبرة</span><h2>شغلك بإيدك. وتنظيمه علينا.</h2><p>قدّم ملفك للمراجعة، ثم أدر طلبات العمل وتقويمك من مساحتك كمزود.</p></div><a class="btn fp-btn-gold" asp-controller="ProviderApplication" asp-action="Apply">انضم كمزود خدمة</a></div>
</section>


