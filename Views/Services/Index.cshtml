@model IReadOnlyList<FixPal.Models.ServiceCategory>
@{ ViewData["Title"] = "خدمات الصيانة"; }
<div class="container fp-workspace"><div class="fp-page-heading"><div><span class="fp-eyebrow">ابدأ بما تحتاجه</span><h1>لكل مشكلة، تخصص.</h1><p>اختر نوع الخدمة لتصفّح المزودين، أو ابدأ بطلب يشرح المشكلة.</p></div></div><div class="fp-provider-grid">@foreach (var category in Model) { <article class="fp-provider-card"><span class="fp-service-icon"><i class="bi @category.Icon" aria-hidden="true"></i></span><h2>@category.Name</h2><p>@category.Description</p><a asp-area="" asp-controller="Providers" asp-action="Index" asp-route-categoryId="@category.Id" class="fp-text-link">تصفّح المزودين <i class="bi bi-arrow-left" aria-hidden="true"></i></a><a asp-area="" asp-controller="MaintenanceRequests" asp-action="Create" asp-route-categoryId="@category.Id" class="btn fp-btn-ghost mt-3">إنشاء طلب</a></article> }</div></div>
