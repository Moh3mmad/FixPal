@model FixPal.Models.ViewModels.CreateMaintenanceRequestViewModel
@using FixPal.Models.Enums
@{ ViewData["Title"] = "إنشاء طلب صيانة"; }
<div class="container fp-workspace">
    <div class="fp-page-heading"><div><span class="fp-eyebrow">طلب جديد</span><h1>خلّينا نبدأ بحل المشكلة.</h1><p>وصف واضح ومكان صحيح يساعدان مزود الخدمة على فهم طلبك.</p></div><a asp-area="" asp-action="Index" class="fp-text-link">العودة إلى طلباتي</a></div>
    <div class="fp-form-layout">
        <form asp-area="" asp-action="Create" method="post" class="fp-form-panel" id="request-form" data-providers-url="@Url.Action("ProviderOptions", "MaintenanceRequests", new { area = "" })">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <section class="fp-form-section">
                <h2><span class="fp-step-number">01</span> ما المشكلة؟</h2>
                <div class="mb-3"><label asp-for="RequestType" class="form-label"></label><select asp-for="RequestType" asp-items="Html.GetEnumSelectList<RequestType>()" class="form-select"></select><span asp-validation-for="RequestType" class="text-danger"></span></div>
                <div id="public-report-note"><partial name="_ReportSafety" /></div>
                <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" placeholder="مثال: تسرب مياه أسفل حوض المطبخ" maxlength="150" /><span asp-validation-for="Title" class="text-danger"></span></div>
                <div><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5" maxlength="2000" placeholder="متى بدأت المشكلة؟ وما الذي لاحظته؟ لا تكتب كلمات مرور أو معلومات مالية."></textarea><span asp-validation-for="Description" class="text-danger"></span><small class="fp-field-hint">حتى 2000 حرف. تفاصيل الطلب متاحة لك وللمزود المعيّن والإدارة فقط.</small></div>
            </section>
            <partial name="_DiagnosisInput" />
            <section class="fp-form-section"><h2><span class="fp-step-number">02</span> التخصص المناسب</h2><label asp-for="ServiceCategoryId" class="form-label"></label><select asp-for="ServiceCategoryId" asp-items="Model.Categories" class="form-select"><option value="">اختر التخصص</option></select><span asp-validation-for="ServiceCategoryId" class="text-danger"></span></section>
            <section class="fp-form-section"><h2><span class="fp-step-number">03</span> أين تقع المشكلة؟</h2>
                <div class="row g-3"><div class="col-md-5"><label asp-for="CityId" class="form-label"></label><select asp-for="CityId" asp-items="Model.Cities" class="form-select"><option value="">اختر المدينة</option></select><span asp-validation-for="CityId" class="text-danger"></span></div>
                <div class="col-md-7"><label asp-for="AreaId" class="form-label"></label><select asp-for="AreaId" class="form-select"><option value="">اختر المنطقة</option>@foreach (var area in Model.Areas) { <option value="@area.Id" data-city="@area.CityId">@area.Name</option> }</select><span asp-validation-for="AreaId" class="text-danger"></span></div></div>
            </section>
            <partial name="_RequestLocationInput" model="Model" />
            <section class="fp-form-section" id="provider-selection"><h2><span class="fp-step-number">04</span> هل لديك مزود مفضل؟</h2>
                <label for="provider-search" class="form-label">ابحث بالاسم ضمن التخصص والمنطقة</label><div class="d-flex gap-2 mb-3"><input id="provider-search" class="form-control" maxlength="100" placeholder="اسم المزود" /><button class="btn fp-btn-ghost" type="button" id="find-providers">بحث</button></div>
                <label asp-for="ProviderProfileId" class="form-label"></label><select asp-for="ProviderProfileId" class="form-select"><option value="">بدون تعيين مزود الآن</option>@if (Model.ProviderProfileId.HasValue && Model.SelectedProviderName != null) { <option value="@Model.ProviderProfileId">@Model.SelectedProviderName</option> }</select><span asp-validation-for="ProviderProfileId" class="text-danger"></span>
                <small class="fp-field-hint" id="provider-search-status" role="status">اختياري. حتى 5 اقتراحات من مزودين معتمدين: تطابق التخصص والمنطقة، ثم التوفر والتقييمات. البحث بالاسم يضيّق النتائج.</small>
                <div id="provider-matches" class="fp-matches" aria-label="اقتراحات المزودين"></div>
                <noscript><p class="fp-notice">يمكنك إرسال الطلب بدون تعيين، أو اختيار مزود من <a asp-area="" asp-controller="Providers" asp-action="Index">دليل المزودين</a> ثم إنشاء الطلب من ملفه.</p></noscript>
            </section>
            <section class="fp-form-section fp-submit-section"><h2><span class="fp-step-number">05</span> راجع وأرسل</h2><p>سيبدأ الطلب بحالة «بانتظار القبول». بدون مزود معيّن سيكون متاحًا لمزود مؤهل في تخصصك ومنطقتك لتوليه وتقديم عرض. يبدأ التنفيذ بعد موافقتك.</p><button class="btn fp-btn-gold" type="submit">تسجيل الطلب <i class="bi bi-arrow-left" aria-hidden="true"></i></button></section>
        </form>
        <aside class="fp-form-aside"><span class="fp-eyebrow">من وصف المشكلة إلى إنجازها</span><h2>كل خطوة واضحة.</h2><ol><li>سجّل المشكلة وحدد المنطقة.</li><li>المزود المعيّن يراجع الطلب ويقبله.</li><li>تابع التنفيذ والصور، ثم قيّم الخدمة بعد اكتمالها.</li></ol><div class="fp-aside-note">اتفقا على نطاق السعر، وتواصلا في محادثة الطلب ووثّقا العمل بالصور. حسابات الدفع محاكاة فقط؛ لا تُجرى دفعات داخل FixPal.</div></aside>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/request-diagnosis.js" asp-append-version="true"></script><script src="~/js/request-location.js" asp-append-version="true"></script><script src="~/js/request-create.js" asp-append-version="true"></script> }






